{
  "taxonomy_version": "metric_relation_taxonomy_development_v0.1",

  "status": "development_only",

  "purpose": "Replace the overloaded binary same_quantity_family target with analytically meaningful relation types.",

  "relation_types": {
    "same_metric_different_state": {
      "description": "The same business metric is represented under different lifecycle states, plans, targets, estimates, observations or realized values."
    },

    "same_process_different_stage": {
      "description": "The metrics describe different stages of the same tracked operational flow or business object."
    },

    "related_distinct_metric": {
      "description": "The metrics are meaningfully related but measure genuinely different phenomena or resources."
    },

    "unrelated": {
      "description": "No sufficiently strong semantic relationship is established."
    },

    "uncertain": {
      "description": "Available evidence is insufficient for a safe semantic classification."
    }
  },

  "clinical_lab": [
    {
      "case_id": "specimens_received_samples_processed",
