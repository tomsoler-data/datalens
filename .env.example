# DataLens environment configuration reference
#
# This file documents the main runtime configuration variables used by
# DataLens. It contains no secrets.
#
# Important:
# - Copy or export only the variables that you need.
# - The current Docker Compose stack already supplies some container-specific
#   values directly in compose.yaml.
# - A root .env file is not itself an authority for model lifecycle state.
# - Never commit private datasets, model secrets, tokens, runtime databases,
#   or protected evaluation material.

# =============================================================================
# LOCAL LLM / OLLAMA
# =============================================================================

# Local-development default used by the backend when no override is provided.
DATALENS_OLLAMA_HOST=http://localhost:11434

# Docker Compose sets this to 1 for the API container and points Ollama to
# host.docker.internal. For direct local development, leave it disabled.
DATALENS_LLM_DOCKER_BRIDGE_ENABLED=0


# =============================================================================
# FRONTEND
# =============================================================================

# Public browser-visible API base URL used by the Next.js application.
NEXT_PUBLIC_DATALENS_API_URL=http://127.0.0.1:8000


# =============================================================================
# CORE PERSISTENCE
# =============================================================================

# Optional override for the main local SQLite database.
# Docker supplies /app/var/datalens.sqlite3 inside the API container.
# Leave commented to use the backend default during direct local development.
# DATALENS_SQLITE_PATH=var/datalens.sqlite3

# Optional Preparation artifact-store override.
# DATALENS_PREPARATION_ARTIFACT_STORE_PATH=var/preparation/artifacts

# Optional analysis/report artifact-store override.
# DATALENS_ANALYSIS_ARTIFACT_STORE_PATH=var/reporting/analysis_artifacts.json

# Optional report-selection store override.
# DATALENS_REPORT_SELECTION_STORE_PATH=var/reporting/report_selection.json

# Optional quarantine location used by permanent Preparation workflow deletion.
# DATALENS_WORKFLOW_DELETE_QUARANTINE_ROOT=var/preparation/deletion-quarantine


# =============================================================================
# MACHINE LEARNING ARTIFACTS
# =============================================================================

# Optional ML artifact-store override.
#
# Backend default:
#   apps/api/var/ml/model_artifacts.json
#
# Relative paths are resolved from the API root.
# DATALENS_ML_MODEL_ARTIFACT_STORE_PATH=var/ml/model_artifacts.json


# =============================================================================
# DEEP LEARNING WORKER
# =============================================================================

# Optional path to the isolated Python executable used by neural time-series
# worker execution.
#
# When unset, the backend resolves the project-local .venv-dl runtime:
#
# Windows:
#   apps/api/.venv-dl/Scripts/python.exe
#
# POSIX:
#   apps/api/.venv-dl/bin/python
#
# Example Windows override:
# DATALENS_DL_PYTHON_PATH=C:/Users/your-user/datalens/apps/api/.venv-dl/Scripts/python.exe


# =============================================================================
# MODEL LIFECYCLE GOVERNANCE
# =============================================================================

# Metadata-only model lifecycle identity/provenance registry.
#
# Backend default:
#   apps/api/var/model_lifecycle/registry.sqlite3
#
# Do not point this at a protected benchmark or model binary.
# DATALENS_MODEL_LIFECYCLE_REGISTRY_PATH=var/model_lifecycle/registry.sqlite3

# Evaluation-decision registry.
#
# Backend default:
#   apps/api/var/model_lifecycle/evaluation_decisions.sqlite3
#
# DATALENS_MODEL_LIFECYCLE_EVALUATION_DECISION_REGISTRY_PATH=var/model_lifecycle/evaluation_decisions.sqlite3


# =============================================================================
# OBSERVABILITY
# =============================================================================

# AI traces are enabled by default. Accepted disabled values include:
# 0, false, no, off
DATALENS_AI_TRACE_ENABLED=1

# Runtime HTTP traces are enabled by default.
DATALENS_RUNTIME_TRACE_ENABLED=1

# Optional AI trace path override.
# Docker supplies /app/var/observability/ai_traces.jsonl.
# DATALENS_AI_TRACE_PATH=var/observability/ai_traces.jsonl

# Optional runtime trace path override.
# Docker supplies /app/var/observability/runtime_requests.jsonl.
# DATALENS_RUNTIME_TRACE_PATH=var/observability/runtime_requests.jsonl


# =============================================================================
# SAFETY / OPERATING NOTES
# =============================================================================

# DataLens is local-first. LLM endpoints must remain compatible with the
# backend's local-only egress guard.
#
# Do not place credentials or bearer tokens in this example file.
#
# Protected evaluation state is not configured here.
# The official Hospital benchmark is:
#
#   CONSUMED / NEVER REPLAY
#
# The current official QLoRA v0.4 lifecycle decision is:
#
#   completed / not_promoted
